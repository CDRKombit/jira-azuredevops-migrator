# Copy to .env and fill in. Never commit .env.
JIRA_URL=https://kombit.atlassian.net
# Jira Cloud: your Atlassian e-mail + an API token (https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_USER=you@kombit.dk
JIRA_API_TOKEN=

ADO_URL=https://dev.azure.com/kombitdk
# PAT scopes: Work Items (Read, write & manage), Project and Team (Read), Identity (Read)
ADO_PAT=
